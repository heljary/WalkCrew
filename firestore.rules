rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profile Rules ---
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.avatarColorIndex is int && data.avatarColorIndex >= 0 && data.avatarColorIndex <= 7 &&
             data.dailyStepGoal is int && data.dailyStepGoal >= 3000 && data.dailyStepGoal <= 20000 &&
             (!('todaySteps' in data) || data.todaySteps is int) &&
             (!('photoUrl' in data) || data.photoUrl == null || data.photoUrl is string) &&
             (!('fcmToken' in data) || data.fcmToken is string) &&
             (!('reminderEnabled' in data) || data.reminderEnabled is bool) &&
             (!('streakDays' in data) || data.streakDays is int) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       isValidUser(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatarColorIndex', 'dailyStepGoal', 'todaySteps', 'photoUrl', 'fcmToken', 'reminderEnabled', 'streakDays', 'updatedAt', 'createdAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Crews Rules ---
    function isValidCrew(data) {
      return data.crewId is string && data.crewId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.inviteCode is string && data.inviteCode.size() == 6 &&
             data.ownerId is string && data.ownerId.size() <= 128 &&
             data.members is list && data.members.size() <= 50 &&
             data.duration is string &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /crews/{crewId} {
      // User can get a crew document to check details or join with invite code,
      // and list only crews they are a member or owner of
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (request.auth.uid in resource.data.members || request.auth.uid == resource.data.ownerId);

      allow create: if isSignedIn() &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().members &&
                       isValidCrew(incoming());

      // Joining crew or owner updating crew
      allow update: if isSignedIn() && (
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['members', 'updatedAt']) &&
          incoming().members.hasAll(existing().members) &&
          incoming().members.size() == existing().members.size() + 1 &&
          request.auth.uid in incoming().members &&
          isValidCrew(incoming())
        ) ||
        (
          existing().ownerId == request.auth.uid &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          isValidCrew(incoming()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'duration', 'updatedAt'])
        )
      );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // --- Step Logs Subcollection ---
      function isValidStepLog(data) {
        return data.userId is string && data.userId == request.auth.uid &&
               data.crewId is string && data.crewId == crewId &&
               data.date is string && data.date.size() == 10 &&
               data.steps is int && data.steps >= 0 &&
               data.createdAt is timestamp && data.createdAt <= request.time &&
               data.updatedAt is timestamp && data.updatedAt <= request.time;
      }

      match /stepLogs/{logId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members);

        allow create: if isSignedIn() &&
                         incoming().userId == request.auth.uid &&
                         (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members) &&
                         isValidStepLog(incoming());

        allow update: if isSignedIn() &&
                         existing().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         incoming().crewId == existing().crewId &&
                         incoming().date == existing().date &&
                         (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members) &&
                         isValidStepLog(incoming());

        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }

      // --- Nudges Subcollection ---
      match /nudges/{nudgeId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members);
        allow create: if isSignedIn() &&
                         incoming().fromUserId == request.auth.uid &&
                         (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members) &&
                         incoming().crewId == crewId;
        allow update, delete: if false;
      }

      // --- Reactions Subcollection ---
      match /reactions/{targetUserId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members);
        allow create, update: if isSignedIn() &&
                                 (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members) &&
                                 incoming().crewId == crewId;
        allow delete: if false;
      }

      // --- Weekly History Subcollection ---
      match /history/{weekId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members);
        allow create, update: if isSignedIn() &&
                                 (request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members) &&
                                 incoming().crewId == crewId;
        allow delete: if isSignedIn() && (request.auth.uid == get(/databases/$(database)/documents/crews/$(crewId)).data.ownerId);
      }
    }

    // --- Invite code lookup index ---
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
                       incoming().code == code &&
                       code.size() == 6;
      allow delete: if isSignedIn();
    }
  }
}



rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCrewMember(crewId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/crews/$(crewId)).data.members;
    }

    // --- User Profile Rules ---
    match /users/{userId} {
      allow read: if isSignedIn(); // Allow other users to see basic profiles for leaderboard
      allow write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // --- Crews Rules ---
    match /crews/{crewId} {
      // Members can read their crew
      allow read: if isSignedIn() && (request.auth.uid in resource.data.members);
      
      // Anyone signed in can create a crew
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      // Update logic:
      // 1. Owner can update anything
      // 2. Non-member can ONLY add themselves to members array
      // 3. Member can ONLY remove themselves from members array
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt']) &&
          (
            // Join: add self
            (
              request.resource.data.members.hasAll(resource.data.members) &&
              request.resource.data.members.size() == resource.data.members.size() + 1 &&
              request.auth.uid in request.resource.data.members
            ) ||
            // Leave: remove self
            (
              resource.data.members.hasAll(request.resource.data.members) &&
              request.resource.data.members.size() == resource.data.members.size() - 1 &&
              !(request.auth.uid in request.resource.data.members)
            )
          )
        )
      );

      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // --- Sub-collections (Step logs, Nudges, Reactions) ---
      match /{allSubcollections=**} {
        allow read, write: if isCrewMember(crewId);
      }
      
      // Specific overrides for sub-collections if needed (e.g., users writing their own logs)
      match /stepLogs/{logId} {
        allow write: if isCrewMember(crewId) && request.resource.data.userId == request.auth.uid;
      }
    }

    // --- Invite code lookup index ---
    match /inviteCodes/{code} {
      // Allow any signed-in user to resolve a code (GET only)
      allow get: if isSignedIn();
      allow list: if false;
      
      // Only the owner of the crew can create/update the invite code
      allow create, update: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
